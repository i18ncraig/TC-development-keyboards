<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>tulalip_lushootseed</kbdname>
    <flags/>
  </header>
  <encoding name="unicode" fontname="Arial" fontsize="-12">
    <layer shift="S">
      <key vkey="K_COLON">ƛ̓</key>
      <key vkey="K_A">qʷ</key>
      <key vkey="K_B">b̓</key>
      <key vkey="K_C">c̓</key>
      <key vkey="K_D">dᶻ</key>
      <key vkey="K_E">q̓ʷ</key>
      <key vkey="K_F">f</key>
      <key vkey="K_G">gʷ</key>
      <key vkey="K_H">h</key>
      <key vkey="K_I">kʷ</key>
      <key vkey="K_J">k̓ʷ</key>
      <key vkey="K_K">k̓</key>
      <key vkey="K_L">l̓</key>
      <key vkey="K_M">m̓</key>
      <key vkey="K_N">n̓</key>
      <key vkey="K_O">o</key>
      <key vkey="K_P">p̓</key>
      <key vkey="K_Q">q̓</key>
      <key vkey="K_R">r</key>
      <key vkey="K_S">s</key>
      <key vkey="K_T">t̓</key>
      <key vkey="K_U">u</key>
      <key vkey="K_V">č̓</key>
      <key vkey="K_W">w̓</key>
      <key vkey="K_X">xʷ</key>
      <key vkey="K_Y">y̓</key>
      <key vkey="K_Z">x̌ʷ</key>
    </layer>
    <layer shift="">
      <key vkey="K_COLON">ɬ</key>
      <key vkey="K_E">ə</key>
      <key vkey="K_F">ʔ</key>
      <key vkey="K_J">ǰ</key>
      <key vkey="K_O">ʷ</key>
      <key vkey="K_R">š</key>
      <key vkey="K_V">č</key>
      <key vkey="K_Z">x̌</key>
    </layer>
  </encoding>
</visualkeyboard>
